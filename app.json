{
  "expo": {
    "name": "SkiaMemRepro",
    "slug": "skia-memory-repro",
    "scheme": "skiarepro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.pranav.skiarepro"
    },
    "android": {
      "package": "com.pranav.skiarepro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": { "minSdkVersion": 26, "buildArchs": ["arm64-v8a"] },
          "ios": { "deploymentTarget": "16.4" }
